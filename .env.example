# --- Ollama (todo local, sin APIs externas) ---
# 127.0.0.1 y no localhost: en Windows localhost prueba primero IPv6 y suma ~2 s a cada llamada.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_TIMEOUT_S=120
OLLAMA_MAX_RETRIES=3
OLLAMA_RETRY_BACKOFF_S=1.0

# --- LLM ---
LLM_MODEL=qwen3.5:4b
# Qwen 3.5 "piensa" antes de responder. Apagado por defecto (latencia y JSON
# mas limpio); cada llamada puede pisarlo con think=True.
LLM_THINK=false
LLM_TEMPERATURE=0.0
LLM_NUM_CTX=8192

# --- Embeddings ---
# Variante cuantizada Q8_0 (~640 MB). El indice vectorial queda ATADO a este
# modelo: si lo cambias, re-ejecuta la ingesta.
EMBED_MODEL=qwen3-embedding:0.6b-q8_0
EMBED_BATCH_SIZE=32

# --- Modulo RAG ---
RAG_RRF_K=60
RAG_CANDIDATES_K=30
USE_RERANKER=false

LOG_LEVEL=INFO

# --- Frontend React ---
# Origenes separados permitidos para el frontend en produccion (lista JSON).
# En desarrollo Vite usa su proxy y no necesita CORS.
FRONTEND_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","https://hackaton-nttdata.vercel.app","https://hackaton-nttdata-5oexvlese-cavassms-projects.vercel.app"]
# Front publicado: start_backend.py imprime <FRONTEND_PUBLIC_URL>/?api=<url del tunnel>
FRONTEND_PUBLIC_URL=https://hackaton-nttdata.vercel.app

# --- Auditor A2A (modules/audit) ---
# token -> agente (JSON). Vacio = todo se rechaza con 401. Usa tokens largos y aleatorios.
A2A_AGENT_TOKENS={"copilot": "cambia-este-token"}
# Agentes autorizados a pedir auditorias (JSON)
A2A_ALLOWED_AGENTS=["copilot"]
# 127.0.0.1 y no localhost: en Windows localhost prueba primero IPv6 y suma ~2 s a cada mensaje A2A.
A2A_PUBLIC_URL=http://127.0.0.1:8100

# --- Cliente nanda (lo usa el agente que pide la auditoria) ---
NANDA_AGENT_ID=copilot
NANDA_AGENT_TOKEN=cambia-este-token
# true = start_backend.py levanta tambien el agente auditor A2A (puerto de A2A_PUBLIC_URL).
NANDA_ENABLED=false
# direct = cases audita en proceso; a2a = el copiloto pide cada auditoria al agente
# auditor por A2A (requiere NANDA_ENABLED=true). La pantalla "Flujo entre agentes"
# muestra cada intercambio A2A sellado en la cadena de hashes.
CASES_AUDIT_MODE=direct

# --- Compliance (modules/compliance) ---
# Valor de la UIT en soles para 2026: S/ 5 500 (D.S. N° 301-2025-EF, verificado por el equipo).
# El codigo no tiene default: si se borra esta
# linea, la exposicion se muestra solo en UIT. Actualizalo cada año.
UIT_VALOR=5500
# Norma de la que se extraen infracciones. Por defecto la 2755-2018 real; para la
# demo con el anexo SINTETICO: NORMA_INFRACCIONES=SINTETICO-ANEXO-INFRACCIONES-LAFT
NORMA_INFRACCIONES=Resolución SBS N° 2755-2018
EXTRACTION_TOP_K=5
EXTRACTION_THINK=false
